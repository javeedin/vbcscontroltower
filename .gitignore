# Dependencies
node_modules/
.pnp/
.yarn/

# Build output
dist/
build/
out/
*.tgz

# VBCS / Visual Builder local artifacts
.vb/
*.vbcs-tmp

# Local DuckDB database (seeded from app/data/seed.json on first run)
*.duckdb
*.duckdb.wal
app/data/*.duckdb

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets — never commit these
.env
.env.*
*.key
*.pem
credentials.json
secrets.json
.secrets.json
app/data/.secrets.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
